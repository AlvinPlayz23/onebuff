{
  "name": "onebuff",
  "version": "1.0.0",
  "description": "Local-first AI coding assistant with multi-agent system - fork of Codebuff with OpenRouter integration",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "onebuff": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "dev-tui": "tsx src/index-tui.ts",
    "start": "node dist/index.js",
    "start-tui": "node dist/index-tui.js",
    "typecheck": "tsc --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "ai",
    "coding",
    "assistant",
    "cli",
    "multi-agent",
    "openrouter",
    "local-first"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlvinPlayz23/onebuff.git"
  },
  "author": "",
  "bugs": {
    "url": "https://github.com/AlvinPlayz23/onebuff/issues"
  },
  "homepage": "https://github.com/AlvinPlayz23/onebuff#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.19",
    "@ai-sdk/openai": "^2.0.36",
    "@openrouter/ai-sdk-provider": "^1.2.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.14",
    "ai": "^5.0.0",
    "axios": "^1.12.2",
    "commander": "^14.0.1",
    "diff": "^8.0.2",
    "ignore": "^7.0.5",
    "ink": "^6.3.1",
    "ink-big-text": "^2.0.0",
    "ink-box": "^1.0.0",
    "ink-divider": "^4.1.1",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-task-list": "^2.0.0",
    "lodash": "^4.17.21",
    "micromatch": "^4.0.8",
    "nanoid": "^5.1.6",
    "picocolors": "^1.1.1",
    "react": "^19.1.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "zod": "^3.25.76"
  }
}
